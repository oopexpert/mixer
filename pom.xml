<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>de.oopexpert.mixer</groupId>
	<artifactId>mixer-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<properties>
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<!-- Frontend-Build (frontend-maven-plugin lädt Node/npm selbst herunter,
			daher kein global installiertes npm nötig, plattformunabhängig) -->
		<frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
		<node.version>v22.12.0</node.version>
		<npm.version>11.0.0</npm.version>
	</properties>

	<!-- Reihenfolge beachten: frontend zuerst, damit backend in
		process-resources das gebaute ../frontend/dist übernehmen kann. -->
	<modules>
		<module>frontend</module>
		<module>backend</module>
	</modules>
</project>
